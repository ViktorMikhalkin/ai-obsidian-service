# .env.example
# Copy to .env or .env.local and adjust as needed.

# Run in safe mode (write index into a temp dir)
AIOBS_TEST_MODE=1
# Optional custom test index dir
# AIOBS_TEST_INDEX_DIR=/tmp/aiobs-test-index

# Optional default model for LLM answers
# OLLAMA_MODEL=llama3.1:8b

# Optional config file override
# AIOBS_CONFIG=./config.yaml
