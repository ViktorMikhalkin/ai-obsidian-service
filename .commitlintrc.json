{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "subject-case": [
      2,
      "never",
      [
        "sentence-case",
        "start-case",
        "pascal-case",
        "upper-case"
      ]
    ],
    "header-max-length": [
      2,
      "always",
      100
    ],
    "scope-enum": [
      2,
      "always",
      [
        "api",
        "index",
        "parser",
        "faiss",
        "rag",
        "cli",
        "docs",
        "ci",
        "repo"
      ]
    ]
  }
}