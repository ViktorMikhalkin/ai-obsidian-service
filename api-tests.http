### ============================================================================
### WORKFLOW TEST SCENARIO
### ============================================================================

### Scenario: Complete workflow
# 1. Check initial state
# 2. Rebuild index
# 3. Verify rebuild
# 4. Search
# 5. Get answer

### Step 1: Get initial state
GET {{baseUrl}}/info

> {%
    client.global.set("workflow_model", response.body.model);
    client.global.set("workflow_count_before", response.body.count);
    client.log("=== WORKFLOW START ===");
    client.log("Initial count: " + response.body.count);
%}

###

### Step 2: Rebuild (commented out - uncomment to run)
# POST {{baseUrl}}/index/rebuild
# Content-Type: application/json
# Accept: text/event-stream
#
# {
#   "root": "{{testRoot}}"
# }

###

### Step 3: Verify rebuild results
GET {{baseUrl}}/info

> {%
    const countBefore = client.global.get("workflow_count_before");
    const countAfter = response.body.count;
    client.log("Count before: " + countBefore);
    client.log("Count after: " + countAfter);
    client.global.set("workflow_count_after", countAfter);
%}

###

### Step 4: Search with updated index
POST {{baseUrl}}/search
Content-Type: application/json

{
  "query": "test query",
  "top_k": 5
}

> {%
    client.log("Search results: " + response.body.hits.length);
    client.global.set("workflow_search_count", response.body.hits.length);
%}

###

### Step 5: Get RAG answer
POST {{baseUrl}}/answer
Content-Type: application/json

{
  "query": "test query",
  "top_k": 5
}

> {%
    client.log("Answer length: " + response.body.answer.length);
    client.log("Citations: " + response.body.citations.length);
    client.log("=== WORKFLOW COMPLETE ===");
%}

