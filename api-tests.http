### ============================================================================
### PERFORMANCE TESTS
### ============================================================================

### Performance test - search latency
POST {{baseUrl}}/search
Content-Type: application/json

{
  "query": "Java programming",
  "top_k": 10
}

> {%
    client.test("Search performance acceptable", function() {
        const timeMs = response.body.total_time_ms;
        client.log("Search took " + timeMs + "ms");

        if (timeMs < 100) {
            client.log("✓ Excellent performance (< 100ms)");
        } else if (timeMs < 500) {
            client.log("✓ Good performance (< 500ms)");
        } else if (timeMs < 1000) {
            client.log("⚠ Acceptable performance (< 1s)");
        } else {
            client.log("⚠ Slow performance (> 1s) - consider optimization");
        }

        // Soft assertion - log warning but don't fail
        if (timeMs > 1000) {
            client.log("WARNING: Search took longer than 1 second");
        }
    });
%}

###

### Edge case - very large top_k
POST {{baseUrl}}/search
Content-Type: application/json

{
  "query": "programming",
  "top_k": 100
}

> {%
    client.test("Large top_k handled correctly", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.hits.length <= 100, "Too many results");
        client.log("Returned " + response.body.hits.length + " results for top_k=100");
    });
%}

