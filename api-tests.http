### ============================================================================
### SEARCH ENDPOINT
### ============================================================================

### Search for Java
POST {{baseUrl}}/search
Content-Type: application/json

{
  "query": "Java programming",
  "top_k": 5
}

> {%
    client.test("Search request successful", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.hits !== undefined, "No hits in response");
        client.assert(Array.isArray(response.body.hits), "Hits is not an array");
        client.assert(response.body.query !== undefined, "No query in response");
        client.assert(response.body.top_k !== undefined, "No top_k in response");
    });

    client.log("Query: " + response.body.query);
    client.log("Found " + response.body.hits.length + " results");
    client.log("Search time: " + response.body.total_time_ms + "ms");

    if (response.body.hits.length > 0) {
        client.log("Top result score: " + response.body.hits[0].score);
    }
%}

