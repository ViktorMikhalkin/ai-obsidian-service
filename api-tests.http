### Variables
@baseUrl = http://127.0.0.1:8000
@testRoot = /data/obsidian-test-lib

### ============================================================================
### INFO ENDPOINT
### ============================================================================

### Get server info
GET {{baseUrl}}/info

> {%
    client.test("Info request successful", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.backend !== undefined, "No backend in response");
    });

    client.log("Backend: " + response.body.backend);
    client.log("Model: " + response.body.model);
    client.log("Count: " + response.body.count);
    client.log("Index Dir: " + response.body.index_dir);

    // Store for later tests
    client.global.set("embedding_model", response.body.model);
    client.global.set("index_count_before", response.body.count);
%}

###

### ============================================================================
### INDEX REBUILD ENDPOINT - SSE STREAMING
### ============================================================================

### Rebuild index with SSE progress (streaming response)
# IMPORTANT: IntelliJ HTTP Client has limited SSE support
# - It will show the full response but may not parse events in real-time
# - For better testing, use curl, Python, or the provided test scripts
POST {{baseUrl}}/index/rebuild
Content-Type: application/json
Accept: text/event-stream

{
  "root": "{{testRoot}}"
}

> {%
    client.test("SSE stream started successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(
            response.headers.valueOf("Content-Type").includes("text/event-stream"),
            "Content-Type is not text/event-stream"
        );
    });

    client.log("=== Index Rebuild Started ===");
    client.log("Check response body for SSE events");

    // Parse and log SSE events
    const lines = response.body.split('\n');
    let eventCount = 0;

    lines.forEach(line => {
        if (line.startsWith('data: ')) {
            eventCount++;
            try {
                const data = JSON.parse(line.substring(6));
                client.log(`Event ${eventCount}: ${data.status}`);

                if (data.status === 'complete') {
                    client.log(`✓ Indexed ${data.indexed} chunks from ${data.total} files`);
                    client.log(`✓ Total time: ${data.total_time_seconds}s`);
                    client.log(`✓ Errors: ${data.errors || 0}`);
                }
            } catch (e) {
                client.log("Failed to parse event: " + line);
            }
        }
    });

    client.log(`Total events received: ${eventCount}`);
%}

###

### ============================================================================
### INDEX REBUILD - ERROR CASES
### ============================================================================

### Test 503: Rebuild already in progress
# NOTE: Run this IMMEDIATELY after starting the previous rebuild
# If the rebuild finishes too quickly, this will return 200 instead
POST {{baseUrl}}/index/rebuild
Content-Type: application/json

{
  "root": "{{testRoot}}"
}

> {%
    client.test("Handles concurrent rebuild correctly", function() {
        if (response.status === 503) {
            client.log("✓ Correctly returned 503 - rebuild in progress");
            client.assert(response.body.code === "INDEX_REBUILDING", "Wrong error code");
            client.assert(response.body.message !== undefined, "No error message");
        } else if (response.status === 200) {
            client.log("⚠ Got 200 - previous rebuild already finished");
        } else {
            client.assert(false, "Unexpected status: " + response.status);
        }
    });
%}

###

### Test 400: Invalid root (path not found)
POST {{baseUrl}}/index/rebuild
Content-Type: application/json

{
  "root": "/this/path/does/not/exist/anywhere"
}

> {%
    client.test("Returns 400 for invalid root path", function() {
        client.assert(response.status === 400, "Response status is not 400");
        client.assert(response.body.code === "ROOT_NOT_FOUND", "Wrong error code");
        client.assert(response.body.message.includes("not found"), "Wrong error message");
    });

    client.log("✓ Correctly rejected invalid path");
%}

###

### Test 400: Root is a file, not directory
# NOTE: Change this to an actual file path in your system for real testing
POST {{baseUrl}}/index/rebuild
Content-Type: application/json

{
  "root": "/etc/hosts"
}

> {%
    client.test("Returns 400 for file instead of directory", function() {
        if (response.status === 400) {
            client.assert(
                response.body.code === "ROOT_NOT_DIR" || response.body.code === "ROOT_NOT_FOUND",
                "Wrong error code: " + response.body.code
            );
            client.log("✓ Correctly rejected file path");
        } else {
            client.log("⚠ Path may not exist on this system");
        }
    });
%}

###

### Test 422: Missing root field
POST {{baseUrl}}/index/rebuild
Content-Type: application/json

{
  "root": ""
}

> {%
    client.test("Returns 422 for empty root", function() {
        client.assert(response.status === 422, "Response status is not 422");
        client.assert(response.body.code === "MISSING_ROOT", "Wrong error code");
    });

    client.log("✓ Correctly rejected empty root");
%}

###

### Test 422: No root field at all
POST {{baseUrl}}/index/rebuild
Content-Type: application/json

{}

> {%
    client.test("Returns 422 for missing root field", function() {
        client.assert(response.status === 422, "Response status is not 422");
    });
%}

###

### ============================================================================
### VERIFY REBUILD RESULTS
### ============================================================================

### Get updated info after rebuild
GET {{baseUrl}}/info

> {%
    client.test("Index count updated after rebuild", function() {
        const countBefore = client.global.get("index_count_before");
        const countAfter = response.body.count;

        client.log("Count before rebuild: " + countBefore);
        client.log("Count after rebuild: " + countAfter);

        if (countBefore !== null && countBefore !== undefined) {
            if (countAfter > countBefore) {
                client.log("✓ Index count increased");
            } else if (countAfter === countBefore) {
                client.log("⚠ Index count unchanged (might be expected if no new files)");
            } else {
                client.log("⚠ Index count decreased (rebuild may have cleared old data)");
            }
        }
    });

    client.global.set("index_count_after", response.body.count);
%}

