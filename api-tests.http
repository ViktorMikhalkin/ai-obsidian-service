### ============================================================================
### ANSWER ENDPOINT (RAG)
### ============================================================================

### Answer with RAG
POST {{baseUrl}}/answer
Content-Type: application/json

{
  "query": "What is Java programming?",
  "top_k": 5
}

> {%
    client.test("Answer request successful", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.answer !== undefined, "No answer in response");
        client.assert(response.body.citations !== undefined, "No citations in response");
        client.assert(Array.isArray(response.body.citations), "Citations is not an array");
        client.assert(response.body.query !== undefined, "No query in response");
    });

    const answer = response.body.answer;
    const preview = answer.length > 100 ? answer.substring(0, 100) + "..." : answer;

    client.log("Query: " + response.body.query);
    client.log("Answer preview: " + preview);
    client.log("Answer length: " + answer.length + " characters");
    client.log("Citations: " + response.body.citations.length);

    // Log citation details
    response.body.citations.forEach((cite, i) => {
        if (i < 3) { // Show first 3 citations
            client.log(`  Citation ${i+1}: ${cite.doc_path || 'unknown'}`);
        }
    });
%}

